pipeline {
    agent any

    tools {
        jdk 'jdk21'
    }

    environment {
        DOCKER_CREDENTIALS = credentials("docker_password") // aici username:password
        GITHUB_TOKEN = credentials("github_token")
    }

    stages {
        stage('Build & Test') {
            steps {
                sh './gradlew clean build'
            }
        }

        stage('Docker Login') {
            steps {
                script {
                    def username = DOCKER_CREDENTIALS_USR // Accesarea username-ului
                    def password = DOCKER_CREDENTIALS_PSW // Accesarea parolei

                    sh """
                        echo "${password}" | docker login -u "${username}" --password-stdin
                    """

                    env.DOCKER_USERNAME = username
                }
            }
        }

        stage('Tag image') {
            steps {
                script {
                    sh('git fetch --tags')
                    env.MAJOR_VERSION = sh(script: 'git tag | sort --version-sort | tail -1 | cut -d . -f 1', returnStdout: true).trim()
                    env.MINOR_VERSION = sh(script: 'git tag | sort --version-sort | tail -1 | cut -d . -f 2', returnStdout: true).trim()
                    env.PATCH_VERSION = sh(script: 'git tag | sort --version-sort | tail -1 | cut -d . -f 3', returnStdout: true).trim()
                    env.IMAGE_TAG = "${MAJOR_VERSION}.$((MINOR_VERSION + 1)).${PATCH_VERSION}"
                }
                sh "docker build -t ${DOCKER_USERNAME}/hello-img:${IMAGE_TAG} ."
                sh "docker push ${DOCKER_USERNAME}/hello-img:${IMAGE_TAG}"

                sh "git tag ${env.IMAGE_TAG}"
                sh "git push https://$GITHUB_TOKEN@github.com/PartyPeeps/service.git ${env.IMAGE_TAG}"
            }
        }


        stage('Test') {
            steps {
                sh "IMAGE_TAG=${env.IMAGE_TAG} docker compose up -d hello mongo"
            }
        }
    }
}
